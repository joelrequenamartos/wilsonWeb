---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActivityCard from '../components/ActivityCard.astro';
import { getActivities } from '../lib/activities';

const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
const activities = await getActivities();

// Pestañas de filtro: las etiquetas que tengan las actividades (Entradas, Excursiones…), en orden de aparición.
const tags = [...new Set(activities.map((a) => a.tag).filter(Boolean))].map((tag) => ({
  tag,
  count: activities.filter((a) => a.tag === tag).length
}));
---
<Layout title="Actividades en Nueva York — Silver Tours NY" description="Entradas, miradores, museos y experiencias en Nueva York. Te contamos lo mejor y te llevamos a la web oficial para reservar.">
  <Header />
  <main id="main">
    <section class="section section-alt">
      <div class="wrap act-wrap">
        <div class="section-head">
          <span class="eyebrow">Qué hacer en Nueva York</span>
          <h1 class="section-title">Actividades en Nueva York</h1>
          <p class="section-sub">Miradores, museos, entradas y experiencias que recomendamos. Pulsa una actividad para ver todos los detalles y, desde ahí, ir a su web para reservar.</p>
        </div>

        {activities.length > 0 ? (
          <>
            <p class="act-count" id="actCount">{activities.length} {activities.length === 1 ? 'actividad' : 'actividades'} en Nueva York</p>
            {tags.length > 1 && (
              <div class="map-tabs act-tabs" role="group" aria-label="Filtrar actividades" id="actTabs">
                <button class="map-tab" data-filter="all" aria-pressed="true">Todas <span class="tab-count">{activities.length}</span></button>
                {tags.map((t) => (
                  <button class="map-tab" data-filter={t.tag} aria-pressed="false">{t.tag} <span class="tab-count">{t.count}</span></button>
                ))}
              </div>
            )}
            <div class="act-list" id="actList">
              {activities.map((a) => <ActivityCard activity={a} />)}
            </div>
          </>
        ) : (
          <p class="act-empty">Estamos preparando las primeras actividades. ¡Vuelve pronto!</p>
        )}
      </div>
    </section>
  </main>

  <div class="act-modal" id="actModal" aria-hidden="true">
    <div class="act-modal-card" role="dialog" aria-modal="true" aria-labelledby="actmTitle">
      <button class="act-modal-close" id="actmClose" type="button" aria-label="Cerrar"><svg class="icon"><use href="#i-close" /></svg></button>
      <div class="act-modal-scroll">
        <div class="act-modal-img" id="actmImg"></div>
        <div class="act-modal-body">
          <h2 class="act-modal-title" id="actmTitle"></h2>
          <span class="act-highlight" id="actmHl" hidden></span>
          <p class="act-modal-desc" id="actmDesc"></p>
          <span class="act-tag" id="actmTag" hidden></span>
        </div>
      </div>
      <div class="act-modal-foot">
        <div class="act-price" id="actmPrice"></div>
        <a class="act-btn" id="actmGo" href="#" target="_blank" rel="noopener noreferrer sponsored">Ver detalles</a>
      </div>
    </div>
  </div>
  <Footer tours={tours} />
</Layout>

<script is:inline>
  // Ficha de la actividad en una ventana: se rellena con los datos de la tarjeta pulsada.
  (function () {
    var modal = document.getElementById('actModal');
    var list = document.getElementById('actList');
    if (!modal || !list) return;
    var last = null;
    var $ = function (id) { return document.getElementById(id); };
    function abrir(card) {
      var img = card.querySelector('.act-img img');
      $('actmImg').innerHTML = img ? '<img src="' + img.getAttribute('src') + '" alt="">' : '<svg class="icon" aria-hidden="true"><use href="#i-ticket" /></svg>';
      $('actmTitle').textContent = card.querySelector('.act-open').textContent;
      var hl = card.querySelector('.act-highlight'); $('actmHl').hidden = !hl; $('actmHl').textContent = hl ? hl.textContent : '';
      var d = card.querySelector('.act-desc'); $('actmDesc').textContent = d ? d.textContent : '';
      var tag = card.querySelector('.act-tag'); $('actmTag').hidden = !tag; $('actmTag').innerHTML = tag ? tag.innerHTML : '';
      $('actmPrice').innerHTML = card.querySelector('.act-price').innerHTML;
      $('actmGo').href = card.getAttribute('data-link');
      last = card.querySelector('.act-open');
      modal.setAttribute('data-open', 'true');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      modal.querySelector('.act-modal-scroll').scrollTop = 0;
      $('actmClose').focus();
    }
    function cerrar() {
      modal.setAttribute('data-open', 'false');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (last) { last.focus(); last = null; }
    }
    list.addEventListener('click', function (e) {
      var card = e.target.closest('.act-card');
      if (card) abrir(card);
    });
    $('actmClose').addEventListener('click', cerrar);
    modal.addEventListener('click', function (e) { if (e.target === modal) cerrar(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal.getAttribute('data-open') === 'true') cerrar(); });
  })();

  (function () {
    var tabs = document.querySelectorAll('#actTabs .map-tab');
    if (!tabs.length) return;
    var cards = document.querySelectorAll('#actList .act-card');
    var count = document.getElementById('actCount');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var f = tab.getAttribute('data-filter');
        tabs.forEach(function (t) { t.setAttribute('aria-pressed', t === tab ? 'true' : 'false'); });
        var n = 0;
        cards.forEach(function (c) {
          var ok = f === 'all' || c.getAttribute('data-tag') === f;
          c.style.display = ok ? '' : 'none';
          if (ok) n++;
        });
        if (count) count.textContent = n + (n === 1 ? ' actividad' : ' actividades') + ' en Nueva York';
      });
    });
  })();
</script>
