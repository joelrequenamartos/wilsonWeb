---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ToursSection from '../components/ToursSection.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import AdBanner from '../components/AdBanner.astro';
import Footer from '../components/Footer.astro';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;

const tours = (await getCollection('tours')).sort(byOrder);
const reviews = (await getCollection('reviews')).sort(byOrder);
const restaurants = (await getCollection('restaurants')).sort(byOrder);
---
<Layout>
  <Header transparent />
  <main id="main">
    <Hero />
    <ToursSection tours={tours} />
    <ReviewsSection reviews={reviews} />
    <section class="section">
      <div class="wrap">
        <AdBanner restaurants={restaurants} />
      </div>
    </section>
  </main>
  <Footer tours={tours} />
</Layout>
