---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TourGallery from '../../components/TourGallery.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { getTourBadge } from '../../lib/tourBadges';

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour) => ({
    params: { id: tour.id },
    props: { tour }
  }));
}

const { tour } = Astro.props;
const t = tour.data;
const allTours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
// Qué tours mostrar en "También te pueden interesar…" para cada tour.
const relatedIds: Record<string, string[]> = {
  'bronx-gospel': ['la-media-maraton', 'maraton-de-wilson', 'free-tour-roosevelt'],
  'free-tour-roosevelt': ['bronx-gospel', 'la-media-maraton', 'maraton-de-wilson'],
  'la-media-maraton': ['maraton-de-wilson', 'bronx-gospel'],
  'maraton-de-wilson': ['la-media-maraton', 'bronx-gospel']
};
const otherTours = (relatedIds[t.id] ?? allTours.filter((other) => other.id !== t.id).map((other) => other.id))
  .map((id) => allTours.find((other) => other.id === id))
  .filter((other): other is (typeof allTours)[number] => Boolean(other));
const badge = getTourBadge(t);

const waHref = 'https://wa.link/w7v2sg';
// Algunos tours reservan por Calendly en vez de WhatsApp.
const CALENDLY_LINKS: Record<string, string> = {
  'free-tour-roosevelt': 'https://calendly.com/silvertoursny/free-tour-roosevelt-manhattan-express',
  'bronx-gospel': 'https://calendly.com/silvertoursny/tour-gosspel-bronx?month=2026-10'
  // La Media Maratón y La Maratón reservan por WhatsApp (waHref): sus Calendly se han quitado.
};
const bookingHref = CALENDLY_LINKS[t.id] ?? waHref;
// Solo en La Maratón y La Media Maratón: el WhatsApp del menú (escritorio) y el botón flotante (móvil) van al chat del tour privado.
const privateWaHref = ['la-media-maraton', 'maraton-de-wilson'].includes(t.id)
  ? 'https://api.whatsapp.com/send?phone=18093213121&text=Hola!%20%F0%9F%91%8B%F0%9F%8F%BB%20Me%20interesa%20saber%20m%C3%A1s%20informaci%C3%B3n%20sobre%20el%20Tour%20Privado'
  : undefined;
const shareImage = t.coverVideoPoster ?? t.coverImage;
const ctaLabel = 'Ver disponibilidad';
// "Tour " delante del título, salvo si ya empieza por "Free Tour" (evita "Tour Free Tour")
const withTour = (title: string) => (/^free tour/i.test(title) ? title : `Tour ${title}`);
// El H1 del tour Bronx usa el nombre corto ("El Bronx & Harlem"); el resto sigue con el nombre completo.
const heroTitle = t.id === 'bronx-gospel' ? t.cardTitle : t.name;
---
<Layout title={`${t.name} — Silver Tours NY`} description={t.detail.intro} image={shareImage} whatsappHref={privateWaHref}>
  <Header transparent={!!(t.coverImage || t.coverVideo)} whatsappHref={privateWaHref} />
  <main id="main">
    <section class:list={['tour-hero', `tour-hero-${t.id}`, { 'tour-hero-photo': t.coverImage || t.coverVideo }]}>
      {t.coverVideo ? (
        <>
          <div class="tour-hero-media">
            <video autoplay muted loop playsinline poster={t.coverVideoPoster} style={t.coverPosition ? `object-position:${t.coverPosition}` : undefined}>
              <source src={t.coverVideo} type="video/mp4" />
            </video>
          </div>
          <div class="tour-hero-scrim"></div>
        </>
      ) : t.coverImage && (
        <>
          <div class="tour-hero-media"><img src={t.coverImage} alt={t.name} style={t.coverPosition ? `object-position:${t.coverPosition}` : undefined} /></div>
          <div class="tour-hero-scrim"></div>
        </>
      )}
      {(t.coverImage || t.coverVideo) && (
        <svg class="hero-cover-curve" viewBox="0 0 100 14" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0,15 L0,11 C 30,11 60,1 100,1 L100,15 Z" />
        </svg>
      )}
      <div class="wrap tour-hero-content">
        <div class="tour-hero-top-row">
          <div class:list={['cat-tag', 'tour-hero-tag', badge?.className]}>
            {badge?.icon && <svg class="icon" style="width:12px;height:12px"><use href={`#${badge.icon}`} /></svg>}
            {badge?.label ?? t.categoryLabel}
          </div>
        </div>
        <h1>{withTour(heroTitle)}</h1>
        {t.detail.subtitle && <p class="tour-hero-subtitle">{t.detail.subtitle}</p>}
      </div>
    </section>

    <section class="section" style="padding-block:40px;">
      <div class="wrap tour-detail-grid">
        <div class="tour-detail-main">
          <div class="tour-hero-meta">
            <span><svg class="icon"><use href="#i-clock" /></svg>{t.duration}</span>
            <span><svg class="icon"><use href={`#${t.levelIcon}`} /></svg>{t.level}</span>
            <span><svg class="icon"><use href="#i-pin" /></svg>{t.location}</span>
          </div>
          <h2 class="tour-detail-h2">Descripción del Tour</h2>
          <div class="tour-intro-wrap" id="tourIntro" data-expanded="false">
            {t.detail.intro.split('\n\n').map((paragraph) => <p class="tour-intro">{paragraph}</p>)}
          </div>
          <button class="tour-intro-toggle" id="tourIntroToggle" aria-expanded="false" aria-controls="tourIntro">Leer más…</button>

          <h2 class="tour-detail-h2">Qué incluye</h2>
          <ul class="tour-check-list">
            {t.detail.includes.map((item) => (
              <li><svg class="icon icon-check"><use href="#i-check" /></svg>{item}</li>
            ))}
            {t.detail.notIncludes && t.detail.notIncludes.map((item) => (
              <li><svg class="icon icon-cross"><use href="#i-close" /></svg>{item}</li>
            ))}
          </ul>

          <h2 class="tour-detail-h2">Lugares que visitarás</h2>
          <div class="tour-places-list">
            {t.detail.places.map((place) => (
              <div class="place-card">
                {place.image
                  ? <div class="place-icon place-icon-photo"><img src={place.image} alt={place.name} /></div>
                  : <div class:list={['place-icon', t.art]}><svg class="icon"><use href="#i-pin" /></svg></div>
                }
                <div>
                  <h3>{place.name}</h3>
                  <p>{place.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <aside class="tour-detail-side">
          <div class="tour-info-card" id="tourInfoCard">
            <div class="tour-price">{t.price}<small>{t.priceNote}</small></div>
            {![`${t.price} ${t.priceNote}`, t.priceNote].includes(t.detail.priceDetail) && (
              <p class="tour-price-detail">{t.detail.priceDetail}</p>
            )}
            <dl class="tour-info-list">
              <div><dt><svg class="icon"><use href="#i-pin" /></svg>Punto de encuentro</dt><dd>{t.detail.meetingPoint}</dd></div>
              <div><dt><svg class="icon"><use href="#i-clock" /></svg>Duración</dt><dd>{t.duration} aprox.</dd></div>
              {t.detail.endPoint && (
                <div><dt><svg class="icon"><use href="#i-flag" /></svg>Punto de finalización</dt><dd>{t.detail.endPoint}</dd></div>
              )}
              <div><dt><svg class="icon"><use href="#i-chat" /></svg>Idioma</dt><dd>{t.detail.language}</dd></div>
              <div><dt><svg class="icon"><use href="#i-tram" /></svg>Transporte</dt><dd>{t.detail.transport}</dd></div>
              <div><dt><svg class="icon"><use href="#i-badge" /></svg>Días del tour</dt><dd>{t.detail.availability}</dd></div>
            </dl>
            <a class="btn btn-primary" style="width:100%; margin-top:20px;" href={bookingHref} target="_blank" rel="noopener">{ctaLabel}</a>
            <p class="tour-info-note">Las reservas se gestionan fuera de esta web.</p>
          </div>
        </aside>
      </div>
    </section>

    {t.gallery && t.gallery.length > 0 && <TourGallery images={t.gallery} title={t.name} />}

    <section class="section" id="faq" style="padding-block:40px;">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="eyebrow">Antes de reservar</span>
          <h2 class="section-title">Preguntas frecuentes</h2>
        </div>
        <div class="tour-faq-list">
          {t.detail.faq.map((item) => (
            <details class="tour-faq-item" name="tour-faq">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt" style="padding-block:40px;">
      <div class="wrap">
        <div class="section-head reveal" style="max-width:none;">
          <span class="eyebrow">Sigue explorando</span>
          <h2 class="section-title related-tours-title">También te pueden interesar…</h2>
        </div>
        <div class="related-tours-grid">
          {otherTours.map((other) => {
            const otherBadge = getTourBadge(other.data);
            return (
            <a class="related-tour-card" href={`/tours/${other.id}`}>
              <div class="related-tour-photo">
                {other.data.coverImage && <img src={other.data.coverImage} alt="" style={other.data.coverPosition ? `object-position:${other.data.coverPosition}` : undefined} />}
                {otherBadge && (
                  <div class:list={['premium-badge', otherBadge.className]}>
                    {otherBadge.icon && <svg class="icon" style="width:12px;height:12px"><use href={`#${otherBadge.icon}`} /></svg>}
                    {otherBadge.label}
                  </div>
                )}
              </div>
              <div class="related-tour-body">
                <span class="related-tour-location"><svg class="icon" style="width:13px;height:13px"><use href="#i-pin" /></svg>{other.data.location}</span>
                <h3>{withTour(other.data.cardTitle)}</h3>
                <p class="desc">{other.data.description}</p>
              </div>
            </a>
            );
          })}
        </div>
      </div>
    </section>

    <CtaBanner />
  </main>

  <div class="mobile-sticky-cta" id="mobileStickyCta">
    <div class="mobile-sticky-price">{t.price}<small>{t.priceNote}</small></div>
    <a class="btn btn-primary" href={bookingHref} target="_blank" rel="noopener">{ctaLabel}</a>
  </div>

  <Footer tours={allTours} />
</Layout>
