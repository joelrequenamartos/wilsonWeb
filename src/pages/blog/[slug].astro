---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogTemplate from '../../components/BlogTemplate.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;

const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
---
<Layout title={`${post.data.title} — Blog Silver Tours NY`} description={post.data.excerpt}>
  <Header />
  <main id="main">
    <section class="section">
      <div class="wrap blog-post-wrap blog-post-wrap-tpl">
        <BlogTemplate title={post.data.title} excerpt={post.data.excerpt} image={post.data.image} />
      </div>
    </section>
  </main>
  <Footer tours={tours} />
</Layout>
