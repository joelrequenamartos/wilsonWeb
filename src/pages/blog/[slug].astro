---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogTemplate from '../../components/BlogTemplate.astro';
import UpcomingEvents from '../../components/UpcomingEvents.astro';
import EbookPopup from '../../components/EbookPopup.astro';
import { getPosts, prepareContent, hasMonthlyEvents } from '../../lib/posts';

export async function getStaticPaths() {
  // «todos» está reservado para el listado paginado (/blog/todos)
  const posts = (await getPosts()).filter((p) => p.slug !== 'todos');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { html, toc } = prepareContent(post.content);
// En la entrada que contiene los eventos mensuales no se repite la lista ni el carrusel: solo salen en el resto de la web.
const hasMonthly = hasMonthlyEvents(post);

const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
---
<Layout title={`${post.title} — Blog Silver Tours NY`} description={post.excerpt} image={post.image ?? undefined}>
  <Header />
  <main id="main">
    <section class="section">
      <div class="wrap blog-post-wrap blog-post-wrap-tpl">
        <BlogTemplate title={post.title} excerpt={post.excerpt} image={post.image ?? undefined} html={html} toc={toc} />
      </div>
    </section>
    {!hasMonthly && <UpcomingEvents />}
  </main>
  <EbookPopup />
  <Footer tours={tours} />
</Layout>
