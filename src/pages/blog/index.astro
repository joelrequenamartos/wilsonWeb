---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogSection from '../../components/BlogSection.astro';
import UpcomingEvents from '../../components/UpcomingEvents.astro';

const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

---
<Layout title="Blog — Silver Tours NY" description="Consejos, rutas y recomendaciones de Wilson para moverte por Nueva York como un local.">
  <Header />
  <main id="main">
    <BlogSection posts={posts} />
    <UpcomingEvents />
  </main>
  <Footer tours={tours} />
</Layout>
