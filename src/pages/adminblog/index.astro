---
// Panel del blog (privado): acceso con el usuario de Supabase y gestión de entradas.
// Todo ocurre en el navegador. Los permisos los imponen las políticas de supabase/schema.sql,
// así que aunque alguien encuentre esta dirección, sin el usuario administrador no puede leer borradores ni escribir.
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Panel de blog — Silver Tours NY</title>
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" />
</head>
<body>
  <main class="app">

    <!-- ACCESO -->
    <section id="loginView" class="card narrow" hidden>
      <h1>Panel del blog</h1>
      <p class="muted">Entra con tu correo y contraseña.</p>
      <form id="loginForm" class="stack">
        <label>Correo<input type="email" id="loginEmail" autocomplete="username" required /></label>
        <label>Contraseña<input type="password" id="loginPass" autocomplete="current-password" required /></label>
        <p class="msg" id="loginMsg" role="alert"></p>
        <button class="btn primary" type="submit">Entrar</button>
      </form>
    </section>

    <!-- LISTA -->
    <section id="listView" hidden>
      <header class="bar">
        <h1>Entradas del blog</h1>
        <div class="bar-actions">
          <button class="btn primary" id="newBtn" type="button">+ Nueva entrada</button>
          <button class="btn" id="rebuildBtn" type="button" title="Vuelve a construir la web con lo que hay guardado">Actualizar web</button>
          <button class="btn ghost" id="logoutBtn" type="button">Salir</button>
        </div>
      </header>
      <p class="banner" id="listMsg" role="status" hidden></p>
      <div id="postList" class="posts"></div>
    </section>

    <!-- EDITAR / CREAR -->
    <section id="editView" hidden>
      <header class="bar">
        <h1 id="editTitle">Nueva entrada</h1>
        <button class="btn ghost" id="backBtn" type="button">← Volver a la lista</button>
      </header>
      <p class="banner error" id="editMsg" role="alert" hidden></p>

      <form id="postForm" class="card stack" novalidate>
        <div class="grid2">
          <label>Título<input type="text" id="fTitle" maxlength="160" /></label>
          <label>Fecha<input type="date" id="fDate" /></label>
        </div>
        <div class="grid2">
          <label>Enlace de la entrada
            <input type="text" id="fSlug" maxlength="120" placeholder="se-genera-desde-el-titulo" />
            <small id="slugHelp" class="muted">Sale del título. /blog/<span id="slugPreview">…</span></small>
          </label>
          <label>Autor<input type="text" id="fAuthor" maxlength="80" value="Wilson Silver" /></label>
        </div>
        <label>Resumen
          <textarea id="fExcerpt" rows="3" maxlength="400" placeholder="Una o dos frases que se ven en Google y bajo el título."></textarea>
        </label>

        <div class="cover">
          <span class="label">Foto de portada</span>
          <div class="cover-row">
            <img id="coverPreview" alt="" hidden />
            <div class="cover-actions">
              <label class="btn">Subir foto<input type="file" id="coverFile" accept="image/*" hidden /></label>
              <button class="btn ghost" id="coverRemove" type="button" hidden>Quitar</button>
              <small class="muted" id="coverStatus">Se reduce sola a 1600 px de ancho.</small>
            </div>
          </div>
        </div>

        <div class="checks">
          <label class="check"><input type="checkbox" id="fFeatured" /> Destacada <small class="muted">(solo con la entrada publicada · solo una a la vez: al marcarla se desmarca la anterior)</small></label>
          <label class="check"><input type="checkbox" id="fPublished" /> Publicada <small class="muted">(para publicar hay que rellenar todo, foto incluida; un borrador puede estar incompleto y no se ve en la web)</small></label>
          <label class="check"><input type="checkbox" id="fMonthly" /> Eventos mensuales <small class="muted">(solo una entrada a la vez: al activarlo aquí se desactiva en la anterior)</small></label>
          <small id="monthlyWarn" class="muted" hidden>⚠ Para usar «Eventos mensuales» hay que ejecutar <b>supabase/monthly-events.sql</b> en Supabase (una sola vez).</small>
        </div>

        <div>
          <span class="label">Texto</span>
          <div id="editor"></div>
        </div>

        <div id="eventsBox" class="card events-box" hidden>
          <span class="label">Eventos mensuales</span>
          <p class="muted events-help">Salen al final de <b>esta</b> entrada y en el carrusel «Próximos eventos» de /blog. Cada evento lleva día y mes, título, subtítulo y un enlace (obligatorio) que se abre en una pestaña nueva.</p>
          <div id="eventsList" class="events-list"></div>
          <button class="btn" id="addEventBtn" type="button">+ Añadir evento</button>
        </div>

        <div class="form-actions">
          <div class="form-actions-left">
            <button class="btn primary" id="saveBtn" type="submit">Guardar</button>
            <button class="btn" id="previewBtn" type="button" title="Abre una pestaña con cómo se verá la entrada, sin guardar ni publicar nada">👁 Vista previa</button>
          </div>
          <button class="btn danger" id="deleteBtn" type="button" hidden>Borrar entrada</button>
        </div>
      </form>
    </section>
  </main>

  <style is:global>
    :root{ --ink:#1A1512; --soft:#5C5147; --mute:#948879; --line:rgba(26,21,18,.16); --coral:#E07A3E; --coral-d:#A8501E; --bg:#F6F2EC; }
    *{box-sizing:border-box;}
    body{margin:0; font-family:"Poppins",system-ui,sans-serif; background:var(--bg); color:var(--ink); line-height:1.5;}
    .app{max-width:980px; margin:0 auto; padding:24px 16px 80px;}
    h1{font-size:clamp(1.5rem,4vw,2rem); margin:0; letter-spacing:-.01em;}
    .muted{color:var(--mute); font-weight:400;}
    .card{background:#fff; border:1px solid var(--line); border-radius:16px; padding:clamp(16px,3vw,28px);}
    .narrow{max-width:420px; margin:12vh auto 0;}
    .stack{display:flex; flex-direction:column; gap:16px;}
    .grid2{display:grid; grid-template-columns:1fr; gap:16px;}
    @media (min-width:700px){.grid2{grid-template-columns:1fr 1fr;}}
    label, .label{display:flex; flex-direction:column; gap:6px; font-weight:600; font-size:.9rem;}
    input[type=text], input[type=email], input[type=password], input[type=date], input[type=url], textarea{
      width:100%; padding:11px 13px; border:1px solid var(--line); border-radius:10px; font:inherit; font-weight:400; background:#fff;
    }
    input:focus, textarea:focus{outline:2px solid var(--coral); outline-offset:1px;}
    input[disabled]{background:#f1ede6; color:var(--soft);}
    .btn{
      display:inline-flex; align-items:center; justify-content:center; gap:6px; padding:10px 18px; border-radius:100px;
      border:1px solid var(--line); background:#fff; color:var(--ink); font:inherit; font-weight:600; font-size:.9rem; cursor:pointer;
    }
    .btn.primary{background:var(--coral); border-color:var(--coral); color:#fff;}
    .btn.danger{background:#fff; border-color:#c0392b; color:#c0392b;}
    .btn.ghost{background:transparent;}
    .btn[disabled]{opacity:.55; cursor:default;}
    .bar{display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:18px;}
    .bar-actions{display:flex; gap:8px; flex-wrap:wrap;}
    .banner{margin:0 0 16px; padding:12px 16px; border-radius:12px; background:#fff3e8; border:1px solid #f0cfae; font-size:.92rem;}
    .banner.error{background:#fdecea; border-color:#f3b9b2; color:#8c2a1f;}
    .banner.ok{background:#e8f6ee; border-color:#b5e0c6; color:#14653a;}
    .msg{margin:0; font-size:.9rem; color:#c0392b; min-height:1.2em;}
    .posts{display:flex; flex-direction:column; gap:10px;}
    .post{display:grid; grid-template-columns:64px 1fr auto; gap:14px; align-items:center; background:#fff; border:1px solid var(--line); border-radius:14px; padding:12px;}
    .post img, .post .ph{width:64px; height:64px; border-radius:10px; object-fit:cover; background:#ece6dc;}
    .post h2{font-size:1rem; margin:0 0 4px; line-height:1.3;}
    .post .meta{display:flex; gap:8px; flex-wrap:wrap; font-size:.78rem; color:var(--soft); align-items:center;}
    .pill{padding:2px 9px; border-radius:100px; font-weight:600; font-size:.72rem; background:#ece6dc;}
    .pill.pub{background:#e1f3e8; color:#14653a;}
    .pill.draft{background:#f3e9d6; color:#8a5a12;}
    .pill.feat{background:#ffe4d0; color:var(--coral-d);}
    .post-actions{display:flex; gap:8px;}
    @media (max-width:600px){.post{grid-template-columns:56px 1fr;} .post-actions{grid-column:1 / -1;} .post img,.post .ph{width:56px;height:56px;}}
    .cover-row{display:flex; gap:16px; align-items:center; flex-wrap:wrap;}
    #coverPreview{width:200px; aspect-ratio:16/9; object-fit:cover; border-radius:12px; border:1px solid var(--line);}
    .cover-actions{display:flex; gap:10px; align-items:center; flex-wrap:wrap;}
    .checks{display:flex; flex-direction:column; gap:10px;}
    .check{flex-direction:row; align-items:center; gap:8px; font-weight:600;}
    .check input{width:18px; height:18px; accent-color:var(--coral);}
    .form-actions{display:flex; gap:10px; justify-content:space-between; flex-wrap:wrap;}
    #editor{min-height:340px; font-family:"Poppins",sans-serif; font-size:1rem; background:#fff;}
    .ql-toolbar.ql-snow{border-radius:10px 10px 0 0; border-color:var(--line); background:#fff;}
    .ql-container.ql-snow{border-radius:0 0 10px 10px; border-color:var(--line);}
    .ql-editor{min-height:340px; line-height:1.7;}
    .ql-editor img{max-width:100%; border-radius:8px; cursor:pointer;}
    .ql-editor img.is-selected{outline:3px solid var(--coral); outline-offset:2px;}
    .form-actions-left{display:flex; gap:10px; flex-wrap:wrap;}
    .events-box{background:#fbf8f3; display:flex; flex-direction:column; gap:14px;}
    .is-missing{border-color:#c0392b !important; outline:2px solid rgba(192,57,43,.28); outline-offset:1px;}
    .cover.is-missing, #editor.is-missing{border-radius:12px;}
    .check.is-off{opacity:.45; cursor:not-allowed;}
    .check.is-off input{cursor:not-allowed;}
    .events-box[hidden]{display:none;} /* sin esto, display:flex se impone al atributo hidden y el bloque se veía siempre */
    .events-help{margin:0; font-size:.88rem;}
    .events-list{display:flex; flex-direction:column; gap:14px;}
    .event-row{background:#fff; border:1px solid var(--line); border-radius:14px; padding:14px; display:flex; flex-direction:column; gap:12px;}
    .event-top{display:flex; align-items:center; justify-content:space-between; font-weight:700; font-size:.9rem;}
    .event-row.is-invalid{border-color:#c0392b;}
    .btn.small{padding:6px 12px; font-size:.8rem;}
    .ql-container{position:relative;}
    .img-tools{position:absolute; z-index:5; display:flex; gap:4px; align-items:center; padding:6px 8px; background:#1A1512; color:#fff; border-radius:10px; box-shadow:0 8px 24px -8px rgba(0,0,0,.5); font-size:.8rem;}
    .img-tools[hidden]{display:none;}
    .img-tools button{border:0; background:transparent; color:#fff; padding:5px 9px; border-radius:7px; font:inherit; font-weight:600; cursor:pointer;}
    .img-tools button:hover, .img-tools button.is-active{background:var(--coral);}
    .img-tools .sep{width:1px; height:18px; background:rgba(255,255,255,.3); margin:0 2px;}
  </style>

  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js" is:inline></script>

  <script>
    import { createClient } from '@supabase/supabase-js';
    import { SUPABASE_URL, SUPABASE_KEY } from '../../lib/supabase';

    const sb = createClient(SUPABASE_URL, SUPABASE_KEY);
    const $ = (id) => document.getElementById(id);
    const BUCKET = 'blog-images';
    const RESERVED = ['todos']; // /blog/todos es el listado paginado

    let session = null;
    let editing = null;       // entrada que se está editando (null = nueva)
    let coverUrl = null;      // portada actual
    let slugTouched = false;  // el usuario ha escrito el enlace a mano
    let quill = null;
    let eventsSupported = true; // false si en Supabase aún no se ha ejecutado monthly-events.sql

    // ---------- utilidades ----------
    const views = ['loginView', 'listView', 'editView'];
    const show = (id) => views.forEach((v) => ($(v).hidden = v !== id));
    const slugify = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    const today = () => new Date().toISOString().slice(0, 10);

    function banner(el, text, kind) {
      el.textContent = text || '';
      el.className = 'banner' + (kind ? ' ' + kind : '');
      el.hidden = !text;
      // Un error del formulario sube la página hasta el aviso: si no, se queda arriba sin verse (el botón Guardar está abajo).
      if (text && kind === 'error' && el.id === 'editMsg') window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ---------- acceso ----------
    async function esAdmin() {
      const { data, error } = await sb.rpc('is_admin');
      return !error && data === true;
    }

    $('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      $('loginMsg').textContent = '';
      const { data, error } = await sb.auth.signInWithPassword({ email: $('loginEmail').value.trim(), password: $('loginPass').value });
      if (error) { $('loginMsg').textContent = 'Correo o contraseña incorrectos.'; return; }
      session = data.session;
      if (!(await esAdmin())) {
        await sb.auth.signOut(); session = null;
        $('loginMsg').textContent = 'Este usuario no tiene permiso para gestionar el blog.';
        return;
      }
      $('loginPass').value = '';
      await showList();
    });

    $('logoutBtn').addEventListener('click', async () => { await sb.auth.signOut(); session = null; show('loginView'); });

    // ---------- lista ----------
    async function showList(message, kind) {
      show('listView');
      banner($('listMsg'), message, kind);
      window.scrollTo(0, 0);
      const { data, error } = await sb.from('posts').select('*').order('published_at', { ascending: false });
      const list = $('postList');
      list.textContent = '';
      if (error) { banner($('listMsg'), 'No se han podido cargar las entradas: ' + error.message, 'error'); return; }
      eventsSupported = data.length ? 'monthly_events' in data[0] : true;
      if (!data.length) { list.textContent = 'Todavía no hay entradas. Pulsa «+ Nueva entrada».'; return; }
      for (const p of data) {
        const row = document.createElement('article');
        row.className = 'post';
        const thumb = p.image ? Object.assign(document.createElement('img'), { src: p.image, alt: '' }) : Object.assign(document.createElement('div'), { className: 'ph' });
        const info = document.createElement('div');
        const h = document.createElement('h2'); h.textContent = p.title;
        const meta = document.createElement('div'); meta.className = 'meta';
        const pill = (txt, cls) => { const s = document.createElement('span'); s.className = 'pill ' + cls; s.textContent = txt; return s; };
        meta.append(pill(p.published ? 'Publicada' : 'Borrador', p.published ? 'pub' : 'draft'));
        if (p.featured) meta.append(pill('★ Destacada', 'feat'));
        if (p.monthly_events) meta.append(pill('📅 Eventos mensuales', 'feat'));
        const d = document.createElement('span'); d.textContent = new Date(p.published_at + 'T12:00:00').toLocaleDateString('es', { day: 'numeric', month: 'long', year: 'numeric' });
        meta.append(d);
        info.append(h, meta);
        const actions = document.createElement('div'); actions.className = 'post-actions';
        const edit = document.createElement('button'); edit.className = 'btn'; edit.type = 'button'; edit.textContent = 'Editar';
        edit.addEventListener('click', () => openEditor(p));
        actions.append(edit);
        row.append(thumb, info, actions);
        list.append(row);
      }
    }

    $('newBtn').addEventListener('click', () => openEditor(null));
    $('backBtn').addEventListener('click', () => showList());

    // ---------- publicar (reconstruir la web) ----------
    async function publicar() {
      try {
        const r = await fetch('/api/publish', { method: 'POST', headers: { Authorization: 'Bearer ' + session.access_token } });
        const j = await r.json().catch(() => ({}));
        if (r.ok) return { ok: true, msg: 'La web se está actualizando: los cambios se verán en /blog en 1-2 minutos.' };
        if (j.error === 'not-configured') return { ok: false, msg: 'Guardado en la base de datos, pero falta conectar la publicación automática con Vercel (DEPLOY_HOOK_URL).' };
        return { ok: false, msg: 'Guardado, pero no se ha podido avisar a la web (' + (j.error || r.status) + ').' };
      } catch { return { ok: false, msg: 'Guardado, pero no se ha podido avisar a la web (sin conexión).' }; }
    }

    $('rebuildBtn').addEventListener('click', async () => {
      $('rebuildBtn').disabled = true;
      const r = await publicar();
      banner($('listMsg'), r.msg, r.ok ? 'ok' : 'error');
      $('rebuildBtn').disabled = false;
    });

    // ---------- fotos ----------
    async function prepararImagen(file) {
      if (file.type === 'image/gif' || file.type === 'image/svg+xml') return { blob: file, ext: file.type === 'image/gif' ? 'gif' : 'svg', type: file.type };
      const bmp = await createImageBitmap(file);
      const scale = Math.min(1, 1600 / bmp.width);
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bmp.width * scale);
      canvas.height = Math.round(bmp.height * scale);
      canvas.getContext('2d').drawImage(bmp, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise((res) => canvas.toBlob(res, 'image/jpeg', 0.85));
      return { blob, ext: 'jpg', type: 'image/jpeg' };
    }

    async function subirImagen(file, carpeta) {
      const img = await prepararImagen(file);
      const nombre = slugify(file.name.replace(/\.[^.]+$/, '')) || 'foto';
      const path = `${carpeta}/${Date.now()}-${nombre}.${img.ext}`;
      const { error } = await sb.storage.from(BUCKET).upload(path, img.blob, { contentType: img.type, upsert: false });
      if (error) throw error;
      return sb.storage.from(BUCKET).getPublicUrl(path).data.publicUrl;
    }

    function pintarPortada() {
      $('coverPreview').hidden = !coverUrl;
      $('coverRemove').hidden = !coverUrl;
      if (coverUrl) { $('coverPreview').src = coverUrl; document.querySelector('.cover').classList.remove('is-missing'); }
    }

    $('coverFile').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      $('coverStatus').textContent = 'Subiendo…';
      try { coverUrl = await subirImagen(file, 'portadas'); pintarPortada(); $('coverStatus').textContent = 'Foto subida.'; }
      catch (err) { $('coverStatus').textContent = 'No se ha podido subir: ' + (err.message || err); }
      e.target.value = '';
    });
    $('coverRemove').addEventListener('click', () => { coverUrl = null; pintarPortada(); });

    // ---------- editor ----------
    function iniciarEditor() {
      if (quill) return;
      quill = new window.Quill('#editor', {
        theme: 'snow',
        placeholder: 'Escribe aquí tu entrada…',
        modules: {
          toolbar: {
            container: [[{ header: [2, 3, false] }], ['bold', 'italic', 'underline'], ['link'], [{ list: 'ordered' }, { list: 'bullet' }], ['blockquote'], ['image'], ['clean']],
            handlers: {
              image() {
                const input = document.createElement('input');
                input.type = 'file'; input.accept = 'image/*';
                input.onchange = async () => {
                  const file = input.files[0];
                  if (!file) return;
                  try {
                    const url = await subirImagen(file, 'texto');
                    const at = quill.getSelection(true).index;
                    quill.insertEmbed(at, 'image', url, 'user');
                    quill.setSelection(at + 1);
                  } catch (err) { banner($('editMsg'), 'No se ha podido subir la foto: ' + (err.message || err), 'error'); }
                };
                input.click();
              }
            }
          }
        }
      });
      iniciarTamanoImagenes();
      quill.on('text-change', () => $('editor').classList.remove('is-missing'));
    }

    // Tamaño de las fotos del texto: al hacer clic en una foto aparece una barrita con 25 % · 50 % · 75 % · 100 % (ancho del texto).
    function iniciarTamanoImagenes() {
      const cont = quill.container;
      const bar = document.createElement('div');
      bar.className = 'img-tools'; bar.hidden = true;
      let sel = null;
      const botones = [['25 %', '25%'], ['50 %', '50%'], ['75 %', '75%'], ['100 %', false]];
      for (const [txt, val] of botones) {
        const b = document.createElement('button');
        b.type = 'button'; b.textContent = txt; b.dataset.w = val === false ? '' : val;
        b.addEventListener('mousedown', (e) => e.preventDefault());
        b.addEventListener('click', () => {
          if (!sel) return;
          const blot = window.Quill.find(sel);
          if (!blot) return;
          quill.formatText(quill.getIndex(blot), 1, 'width', val, 'user');
          colocar();
        });
        bar.append(b);
      }
      const sep = document.createElement('span'); sep.className = 'sep'; bar.append(sep);
      const del = document.createElement('button');
      del.type = 'button'; del.textContent = 'Quitar foto';
      del.addEventListener('mousedown', (e) => e.preventDefault());
      del.addEventListener('click', () => {
        if (!sel) return;
        const blot = window.Quill.find(sel);
        if (blot) quill.deleteText(quill.getIndex(blot), 1, 'user');
        ocultar();
      });
      bar.append(del);
      cont.append(bar);

      function colocar() {
        if (!sel || !sel.isConnected) return ocultar();
        const c = cont.getBoundingClientRect();
        const r = sel.getBoundingClientRect();
        bar.hidden = false;
        bar.style.top = Math.max(4, r.top - c.top + cont.scrollTop - bar.offsetHeight - 6) + 'px';
        bar.style.left = Math.max(4, r.left - c.left) + 'px';
        const actual = sel.getAttribute('width') || '';
        bar.querySelectorAll('button[data-w]').forEach((b) => b.classList.toggle('is-active', b.dataset.w === actual));
      }
      function ocultar() {
        if (sel) sel.classList.remove('is-selected');
        sel = null; bar.hidden = true;
      }
      quill.root.addEventListener('click', (e) => {
        if (e.target.tagName === 'IMG') {
          if (sel) sel.classList.remove('is-selected');
          sel = e.target; sel.classList.add('is-selected'); colocar();
        } else ocultar();
      });
      quill.on('text-change', () => { if (sel) colocar(); });
      window.addEventListener('resize', () => { if (sel) colocar(); });
    }

    // ---------- «Destacada» solo está disponible con la entrada publicada ----------
    // Sin publicar se ve apagada y desmarcada; al volver a marcar «Publicada» se reactiva y recupera su valor.
    let destacadaGuardada = false;
    function syncDestacada() {
      const pub = $('fPublished').checked;
      const f = $('fFeatured');
      if (!pub && !f.disabled) { destacadaGuardada = f.checked; f.checked = false; }
      if (pub && f.disabled) f.checked = destacadaGuardada;
      f.disabled = !pub;
      f.closest('label').classList.toggle('is-off', !pub);
    }
    $('fPublished').addEventListener('change', syncDestacada);

    // ---------- eventos mensuales ----------
    const isUrl = (u) => /^https?:\/\/\S+$/i.test(u);

    function renumerar() {
      [...$('eventsList').children].forEach((row, i) => { row.querySelector('.event-num').textContent = 'Evento ' + (i + 1); });
    }

    function addEventRow(ev = {}) {
      const row = document.createElement('div');
      row.className = 'event-row';
      row.innerHTML = `
        <div class="event-top"><span class="event-num"></span><button class="btn small danger" type="button">Quitar</button></div>
        <div class="grid2">
          <label>Fecha (día y mes)<input type="date" data-f="date" /></label>
          <label>Título<input type="text" data-f="title" maxlength="120" placeholder="Concierto de jazz" /></label>
        </div>
        <div class="grid2">
          <label>Subtítulo<input type="text" data-f="subtitle" maxlength="160" placeholder="con Ana García · Harlem" /></label>
          <label>Enlace del botón (obligatorio)<input type="url" data-f="link" placeholder="https://…" /></label>
        </div>`;
      row.querySelector('[data-f=date]').value = ev.date || '';
      row.querySelector('[data-f=title]').value = ev.title || '';
      row.querySelector('[data-f=subtitle]').value = ev.subtitle || '';
      row.querySelector('[data-f=link]').value = ev.link || '';
      row.querySelector('button').addEventListener('click', () => { row.remove(); renumerar(); });
      $('eventsList').append(row);
      renumerar();
    }

    function readEvents() {
      return [...$('eventsList').children].map((row) => {
        const f = (k) => row.querySelector(`[data-f=${k}]`).value.trim();
        return { date: f('date'), title: f('title'), subtitle: f('subtitle'), link: f('link') };
      }).filter((e) => e.date || e.title || e.subtitle || e.link); // las filas totalmente vacías se ignoran
    }

    function pintarEventos(list) {
      $('eventsList').textContent = '';
      (list || []).forEach((e) => addEventRow(e));
    }

    function toggleEventsBox() {
      const on = $('fMonthly').checked && eventsSupported;
      $('eventsBox').hidden = !on;
      if (on && !$('eventsList').children.length) addEventRow();
    }
    $('fMonthly').addEventListener('change', toggleEventsBox);
    $('addEventBtn').addEventListener('click', () => { if ($('fMonthly').checked) addEventRow(); }); // solo con «Eventos mensuales» activo

    // Vista previa: guarda el borrador actual en el navegador y abre /blog-preview con el diseño real, sin guardar ni publicar nada.
    $('previewBtn').addEventListener('click', () => {
      const draft = {
        title: $('fTitle').value.trim(),
        excerpt: $('fExcerpt').value.trim(),
        image: coverUrl,
        content: quill.getSemanticHTML().replace(/&nbsp;/g, ' '),
        monthly: $('fMonthly').checked && eventsSupported,
        events: readEvents().filter((e) => e.date && e.title)
      };
      try { localStorage.setItem('blog-preview', JSON.stringify(draft)); }
      catch { return banner($('editMsg'), 'No se ha podido preparar la vista previa en este navegador.', 'error'); }
      window.open('/adminblog/vista-previa', '_blank');
    });

    function openEditor(post) {
      editing = post;
      slugTouched = !!post;
      banner($('editMsg'), '');
      show('editView');
      iniciarEditor();
      $('editTitle').textContent = post ? 'Editar entrada' : 'Nueva entrada';
      $('fTitle').value = post?.title ?? '';
      $('fDate').value = post?.published_at ?? today();
      $('fSlug').value = post?.slug ?? '';
      $('fAuthor').value = post?.author ?? 'Wilson Silver';
      $('fExcerpt').value = post?.excerpt ?? '';
      $('fPublished').checked = post ? !!post.published : false;
      destacadaGuardada = !!post?.featured;
      $('fFeatured').checked = destacadaGuardada && $('fPublished').checked;
      $('fFeatured').disabled = !$('fPublished').checked;
      $('fFeatured').closest('label').classList.toggle('is-off', !$('fPublished').checked);
      $('fMonthly').checked = !!post?.monthly_events;
      $('fMonthly').disabled = !eventsSupported;
      $('monthlyWarn').hidden = eventsSupported;
      pintarEventos(Array.isArray(post?.events) ? post.events : []);
      toggleEventsBox();
      coverUrl = post?.image ?? null;
      pintarPortada();
      $('coverStatus').textContent = 'Se reduce sola a 1600 px de ancho.';
      quill.setContents([]);
      if (post?.content) quill.clipboard.dangerouslyPasteHTML(post.content);
      // El enlace queda bloqueado cuando la entrada ya está publicada (para no romper enlaces compartidos).
      const bloqueado = !!post && post.published;
      $('fSlug').disabled = bloqueado;
      $('slugHelp').firstChild.textContent = bloqueado ? 'Bloqueado porque ya está publicada. /blog/' : 'Sale del título. /blog/';
      $('slugPreview').textContent = $('fSlug').value || '…';
      $('deleteBtn').hidden = !post;
      window.scrollTo(0, 0);
    }

    $('postForm').addEventListener('input', (e) => { if (e.target.classList) e.target.classList.remove('is-missing'); });
    $('fTitle').addEventListener('input', () => {
      if (!slugTouched) { $('fSlug').value = slugify($('fTitle').value); $('slugPreview').textContent = $('fSlug').value || '…'; }
    });
    $('fSlug').addEventListener('input', () => {
      slugTouched = true;
      $('fSlug').value = slugify($('fSlug').value);
      $('slugPreview').textContent = $('fSlug').value || '…';
    });

    // ---------- guardar ----------
    $('postForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      banner($('editMsg'), '');
      const title = $('fTitle').value.trim();
      const slug = $('fSlug').value.trim() || slugify(title);
      if (!title) return banner($('editMsg'), 'Escribe un título.', 'error');
      if (!slug) return banner($('editMsg'), 'El enlace no puede estar vacío.', 'error');
      if (RESERVED.includes(slug)) return banner($('editMsg'), `El enlace «${slug}» está reservado. Elige otro.`, 'error');
      const publicar_ = $('fPublished').checked;
      document.querySelectorAll('.is-missing').forEach((x) => x.classList.remove('is-missing'));

      // Para PUBLICAR, todos los campos son obligatorios (foto incluida). Un borrador puede estar incompleto.
      if (publicar_) {
        const falta = [];
        const marcar = (el, nombre) => { falta.push(nombre); el.classList.add('is-missing'); };
        if (!title) marcar($('fTitle'), 'título');
        if (!$('fDate').value) marcar($('fDate'), 'fecha');
        if (!slug) marcar($('fSlug'), 'enlace');
        if (!$('fAuthor').value.trim()) marcar($('fAuthor'), 'autor');
        if (!$('fExcerpt').value.trim()) marcar($('fExcerpt'), 'resumen');
        if (!coverUrl) marcar(document.querySelector('.cover'), 'foto de portada');
        const sinTexto = !quill.root.textContent.trim() && !quill.root.querySelector('img'); // se lee de lo que se ve en el editor
        if (sinTexto) marcar($('editor'), 'texto');
        if (falta.length) {
          return banner($('editMsg'), 'Para publicar falta rellenar: ' + falta.join(', ') + '. Si aún no está lista, desmarca «Publicada» y guárdala como borrador.', 'error');
        }
      }

      const monthly = $('fMonthly').checked && eventsSupported;
      const events = readEvents();
      if (monthly && publicar_ && !events.length) {
        $('eventsBox').classList.add('is-missing');
        return banner($('editMsg'), 'Para publicar con «Eventos mensuales» activo añade al menos un evento (o desmarca esa casilla).', 'error');
      }
      if (monthly) {
        const rows = [...$('eventsList').children];
        rows.forEach((r) => r.classList.remove('is-invalid'));
        for (let i = 0; i < events.length; i++) {
          const e = events[i];
          let problema = '';
          if (!e.date) problema = 'falta la fecha';
          else if (!e.title) problema = 'falta el título';
          else if (publicar_ && !e.subtitle) problema = 'falta el subtítulo';
          else if (!e.link) problema = 'falta el enlace del botón (es obligatorio)';
          else if (!isUrl(e.link)) problema = 'el enlace debe empezar por https:// o http://';
          if (problema) {
            const filas = rows.filter((r) => [...r.querySelectorAll('[data-f]')].some((x) => x.value.trim()));
            if (filas[i]) filas[i].classList.add('is-invalid');
            return banner($('editMsg'), `Evento ${i + 1}: ${problema}.`, 'error');
          }
        }
      }
      const row = {
        slug, title,
        excerpt: $('fExcerpt').value.trim(),
        content: quill.getSemanticHTML().replace(/&nbsp;/g, ' '), // sin espacios «duros»: así el texto salta de línea
        author: $('fAuthor').value.trim() || 'Wilson Silver',
        image: coverUrl,
        featured: $('fFeatured').checked && $('fPublished').checked, // un borrador nunca es la destacada
        published: $('fPublished').checked,
        published_at: $('fDate').value || today(),
        // Solo se envían si la base de datos ya tiene las columnas (supabase/monthly-events.sql).
        ...(eventsSupported ? { monthly_events: monthly, events } : {})
      };
      $('saveBtn').disabled = true;
      let saved, error;
      if (editing) ({ data: saved, error } = await sb.from('posts').update(row).eq('id', editing.id).select().single());
      else ({ data: saved, error } = await sb.from('posts').insert(row).select().single());
      if (error) {
        $('saveBtn').disabled = false;
        const dup = error.code === '23505';
        return banner($('editMsg'), dup ? 'Ya existe una entrada con ese enlace. Cambia el título o el enlace.' : 'No se ha podido guardar: ' + error.message, 'error');
      }
      // Solo una destacada a la vez.
      if (row.featured) await sb.from('posts').update({ featured: false }).neq('id', saved.id).eq('featured', true);
      const r = await publicar();
      $('saveBtn').disabled = false;
      await showList('Entrada guardada. ' + r.msg, r.ok ? 'ok' : 'error');
    });

    // ---------- borrar ----------
    $('deleteBtn').addEventListener('click', async () => {
      if (!editing) return;
      if (!confirm(`¿Borrar «${editing.title}»? No se puede deshacer.`)) return;
      const { error } = await sb.from('posts').delete().eq('id', editing.id);
      if (error) return banner($('editMsg'), 'No se ha podido borrar: ' + error.message, 'error');
      const r = await publicar();
      await showList('Entrada borrada. ' + r.msg, r.ok ? 'ok' : 'error');
    });

    // ---------- arranque ----------
    (async () => {
      const { data } = await sb.auth.getSession();
      session = data.session;
      sb.auth.onAuthStateChange((_ev, s) => { session = s; });
      if (session && (await esAdmin())) await showList();
      else show('loginView');
    })();
  </script>
</body>
</html>
