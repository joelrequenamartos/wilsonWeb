---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EbookSection from '../components/EbookSection.astro';

const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="Ebook — Silver Tours NY" description="La guía secreta de Nueva York: rutas fuera del circuito turístico.">
  <Header />
  <main id="main">
    <EbookSection />
  </main>
  <Footer tours={tours} />
</Layout>
