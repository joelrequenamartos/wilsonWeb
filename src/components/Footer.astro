---
import type { CollectionEntry } from 'astro:content';

interface Props {
  tours: CollectionEntry<'tours'>[];
}

const { tours } = Astro.props;

const exploreLinks = [
  { href: '/#restaurantes', label: 'Restaurantes' },
  { href: '/#resenas', label: 'Reseñas' },
  { href: '/#ebook', label: 'Ebook' }
];

const socials = [
  { icon: 'i-ig', label: 'Instagram' },
  { icon: 'i-tiktok', label: 'TikTok' },
  { icon: 'i-fb', label: 'Facebook' },
  { icon: 'i-yt', label: 'YouTube' }
];
---
<footer class="site" id="contacto">
  <div class="wrap footer-grid">
    <div>
      <img class="brand-logo" src="/images/brand/logo-color.png" alt="Silver Tours NY" />
      <p class="footer-desc">Tours guiados por un local, pensados como rutas con historia: deporte, cultura, gastronomía y los rincones que Nueva York no enseña en las postales.</p>
      <div class="social-row">
        {socials.map((s) => (
          <a href="#" aria-label={s.label}><svg class="icon" style="width:17px;height:17px"><use href={`#${s.icon}`} /></svg></a>
        ))}
      </div>
    </div>
    <div class="footer-col">
      <h4>Tours</h4>
      <ul>
        {tours.map((tour) => <li><a href="/#tours">{tour.data.shortName}</a></li>)}
      </ul>
    </div>
    <div class="footer-col">
      <h4>Explorar</h4>
      <ul>
        {exploreLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>
    <div class="footer-col">
      <h4>Contacto</h4>
      <ul class="footer-contact">
        <li><svg class="icon"><use href="#i-pin" /></svg>99 Wall Street, Suite 3255, New York, NY 10005</li>
        <li><svg class="icon"><use href="#i-phone" /></svg>+1 (646) 629-7581</li>
        <li><svg class="icon"><use href="#i-mail" /></svg>info@silvertoursny.com</li>
      </ul>
      <div class="footer-news">
        <input type="email" placeholder="Tu email" aria-label="Tu email" />
        <a class="btn btn-primary btn-sm" href="#" style="flex:none;">Unirme</a>
      </div>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>&copy; <span id="year"></span> Silver Tours NY. Mockup de diseño — todos los precios son ilustrativos.</span>
    <span>Hecho por un neoyorquino, para el mundo.</span>
  </div>
</footer>
