---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

const day = new Intl.DateTimeFormat('es', { day: '2-digit', month: 'short' });
const year = new Intl.DateTimeFormat('es', { year: 'numeric' });
---
<section class="section" id="blog">
  <div class="wrap blog-agenda reveal">
    <h1 class="blog-agenda-title">Blog.</h1>
    <div class="blog-agenda-list">
      {posts.map((post) => (
        <a class="blog-agenda-row" href={`/blog/${post.id}`}>
          <div class="blog-agenda-when">
            <span class="blog-agenda-date">{day.format(post.data.date).replace('.', '')} {year.format(post.data.date)}</span>
            {post.data.image && <img class="blog-agenda-photo" src={post.data.image} alt="" loading="lazy" />}
          </div>
          <div class="blog-agenda-body">
            <h3>{post.data.title}</h3>
            <span class="blog-agenda-by">Por {post.data.author} · {post.data.readTime}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
