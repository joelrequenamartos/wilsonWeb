---
import type { CollectionEntry } from 'astro:content';

interface Props {
  tours: CollectionEntry<'tours'>[];
  restaurants: CollectionEntry<'restaurants'>[];
  places: CollectionEntry<'places'>[];
}

const { tours, restaurants, places } = Astro.props;

const tourPins = tours.filter((t) => t.data.mapPosition);
const foodPins = restaurants.filter((r) => r.data.mapPosition);
const placePins = places.filter((p) => p.data.mapPosition);
---
<section class="section section-alt" id="mapa">
  <div class="wrap map-shell">
    <div class="section-head reveal" style="margin-bottom:8px;">
      <span class="eyebrow">Explora antes de llegar</span>
      <h2 class="section-title">Un mapa con tours, mesas y paradas</h2>
      <p class="section-sub">Filtra por categoría para ver dónde encaja cada experiencia. Mapa ilustrativo, no a escala.</p>
    </div>

    <div class="map-tabs" role="group" aria-label="Filtrar mapa" id="mapTabs">
      <button class="map-tab" data-filter="all" aria-pressed="true">Todo</button>
      <button class="map-tab" data-filter="tours" aria-pressed="false"><svg class="icon" style="width:14px;height:14px"><use href="#i-baseball" /></svg>Tours</button>
      <button class="map-tab" data-filter="food" aria-pressed="false"><svg class="icon" style="width:14px;height:14px"><use href="#i-fork" /></svg>Restaurantes</button>
      <button class="map-tab" data-filter="places" aria-pressed="false"><svg class="icon" style="width:14px;height:14px"><use href="#i-pin" /></svg>Lugares</button>
    </div>

    <div class="map-box" id="mapBox" aria-label="Mapa ilustrativo de Nueva York">
      <span class="map-zone" style="top:8%; left:6%;">Bronx</span>
      <span class="map-zone" style="top:24%; left:30%;">Harlem</span>
      <span class="map-zone" style="top:50%; left:44%;">Midtown</span>
      <span class="map-zone" style="top:68%; left:70%;">Roosevelt Island</span>
      <span class="map-zone" style="top:80%; left:20%;">Downtown</span>

      {tourPins.map((tour) => (
        <div class="pin pin-tours" data-cat="tours" style={`top:${tour.data.mapPosition!.top}; left:${tour.data.mapPosition!.left};`} title={tour.data.shortName}>
          <svg class="icon"><use href={`#${tour.data.icon}`} /></svg>
        </div>
      ))}

      {foodPins.map((restaurant) => (
        <div class="pin pin-food" data-cat="food" style={`top:${restaurant.data.mapPosition!.top}; left:${restaurant.data.mapPosition!.left};`} title={restaurant.data.name}>
          <svg class="icon"><use href="#i-fork" /></svg>
        </div>
      ))}

      {placePins.map((place) => (
        <div class="pin pin-places" data-cat="places" style={`top:${place.data.mapPosition!.top}; left:${place.data.mapPosition!.left};`} title={place.data.name}>
          <svg class="icon"><use href={`#${place.data.icon}`} /></svg>
        </div>
      ))}
    </div>

    <div class="map-legend">
      <span><i class="legend-dot" style="background:var(--cat-sports)"></i>Tours</span>
      <span><i class="legend-dot" style="background:var(--coral)"></i>Restaurantes</span>
      <span><i class="legend-dot" style="background:var(--gold)"></i>Lugares de interés</span>
    </div>
  </div>
</section>
