---
import type { CollectionEntry } from 'astro:content';

interface Props {
  tour: CollectionEntry<'tours'>['data'];
}

const { tour } = Astro.props;
const isFree = !tour.premium && tour.category === 'free';
---
<article class:list={['tour-card', { premium: tour.premium, free: isFree }]}>
  {tour.premium && (
    <div class="premium-badge"><svg class="icon" style="width:12px;height:12px"><use href="#i-star" /></svg>Premium</div>
  )}
  {isFree && (
    <div class="premium-badge free-badge">Gratuito</div>
  )}
  <div class:list={['tour-art', tour.art, { 'tour-art-photo': tour.coverImage }]}>
    {tour.coverImage && <img src={tour.coverImage} alt={tour.name} style={tour.coverPosition ? `object-position:${tour.coverPosition}` : undefined} />}
  </div>
  <div class="tour-perf"><span class="notch notch-l"></span><span class="notch notch-r"></span></div>
  <div class="tour-body">
    <div class="tour-heading">
      <h3><a class="tour-title-link" href={`/tours/${tour.id}`}>{tour.name}</a></h3>
    </div>
    <p class="desc">{tour.description}</p>
    <div class="tour-meta">
      <span><svg class="icon"><use href="#i-clock" /></svg>{tour.duration}</span>
      <span><svg class="icon"><use href="#i-pin" /></svg>{tour.location}</span>
      <span><svg class="icon"><use href={`#${tour.levelIcon}`} /></svg>{tour.level}</span>
    </div>
    <a class="btn btn-outline tour-cta" href={`/tours/${tour.id}`}>Ver detalles <svg class="icon"><use href="#i-arrow" /></svg></a>
  </div>
</article>
