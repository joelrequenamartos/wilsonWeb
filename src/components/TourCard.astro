---
import type { CollectionEntry } from 'astro:content';
import { getTourBadge } from '../lib/tourBadges';

interface Props {
  tour: CollectionEntry<'tours'>['data'];
}

const { tour } = Astro.props;
const isFree = !tour.premium && tour.category === 'free';
const isAccent = tour.id === 'bronx-gospel';
const cardTitle = tour.name.replace(/^Free Tour:?\s*/i, '');
const badge = getTourBadge(tour);
---
<article class:list={['tour-card', { premium: tour.premium, free: isFree, accent: isAccent }]}>
  <a class="tour-card-link" href={`/tours/${tour.id}`}>
    {badge && (
      <div class:list={['premium-badge', badge.className]}>
        {badge.icon && <svg class="icon" style="width:12px;height:12px"><use href={`#${badge.icon}`} /></svg>}
        {badge.label}
      </div>
    )}
    <div class:list={['tour-art', tour.art, { 'tour-art-photo': tour.coverImage }]}>
      {tour.coverImage && <img src={tour.coverImage} alt="" style={tour.coverPosition ? `object-position:${tour.coverPosition}` : undefined} />}
    </div>
    <div class="tour-scrim" aria-hidden="true"></div>
    <div class="tour-overlay">
      <h3 class="tour-overlay-title">{cardTitle}</h3>
    </div>
  </a>
</article>
