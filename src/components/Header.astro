---
const navLinks = [
  { href: '/#tours', label: 'Tours' },
  { href: '/#restaurantes', label: 'Restaurantes' },
  { href: '/#lugares', label: 'Lugares' },
  { href: '/#mapa', label: 'Mapa' },
  { href: '/#resenas', label: 'Reseñas' },
  { href: '/#ebook', label: 'Ebook' },
  { href: '/#contacto', label: 'Contacto' }
];
---
<header class="site">
  <div class="wrap nav">
    <a class="brand" href="#main">
      <svg class="brand-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <path d="M20 3C12 3 6 9.2 6 17c0 11 14 20 14 20s14-9 14-20C34 9.2 28 3 20 3z" fill="var(--coral)" />
        <circle cx="20" cy="17" r="6.4" fill="var(--bg)" />
        <path d="M14 17.5l4 4 8-8.5" stroke="var(--coral)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      </svg>
      <span class="brand-word">Silver Tours <em>NY</em></span>
    </a>
    <nav>
      <ul class="nav-links" id="navLinks" data-open="false">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="nav-cta">
      <a class="nav-phone" href="tel:+16466297581"><svg class="icon"><use href="#i-phone" /></svg>+1 (646) 629-7581</a>
      <a class="btn btn-primary btn-sm" href="/#tours">Reservar ahora</a>
      <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navLinks" aria-label="Abrir menú">
        <svg class="icon" style="width:26px;height:26px" id="navIconOpen"><use href="#i-menu" /></svg>
        <svg class="icon" style="width:26px;height:26px;display:none" id="navIconClose"><use href="#i-close" /></svg>
      </button>
    </div>
  </div>
</header>
