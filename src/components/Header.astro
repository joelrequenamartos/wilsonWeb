---
interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const navLinks = [
  { href: '/#tours', label: 'Tours' },
  { href: '/restaurantes', label: 'Restaurantes' },
  { href: '/ebook', label: 'Ebook' },
  { href: '/blog', label: 'Blog' },
  { href: '/sobre-wilson', label: 'Sobre Wilson' }
];
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <clipPath id="navWaveClip" clipPathUnits="objectBoundingBox">
    <path d="M0,0 L1,0 L1,0.85 C0.7,0.85 0.4,0.97 0,0.97 Z" />
  </clipPath>
</svg>
<header class="site" data-transparent-hero={transparent ? 'true' : 'false'}>
  <div class="wrap nav">
    <a class="brand" href="/">
      <span class="brand-logo-wrap">
        <img class="brand-logo brand-logo-color" src="/images/brand/logo-color.png" alt="Silver Tours NY" />
        <img class="brand-logo brand-logo-white" src="/images/brand/logo-white.png" alt="" aria-hidden="true" />
      </span>
    </a>
    <nav>
      <div class="nav-links-wrap">
        <ul class="nav-links" id="navLinks" data-open="false">
          {navLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </nav>
    <div class="nav-cta">
      <a class="nav-whatsapp" href="https://wa.me/16466297581?text=Hola%2C%20quiero%20m%C3%A1s%20informaci%C3%B3n" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
        <img src="/images/brand/whatsapp.svg" alt="WhatsApp" />
      </a>
      <a class="btn btn-primary btn-sm nav-reserve-btn" href="/#tours">Reservar Tours</a>
      <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navLinks" aria-label="Abrir menú">
        <svg class="icon" style="width:26px;height:26px" id="navIconOpen"><use href="#i-menu" /></svg>
        <svg class="icon" style="width:26px;height:26px;display:none" id="navIconClose"><use href="#i-close" /></svg>
      </button>
    </div>
  </div>
</header>
