---
const benefits = [
  { icon: 'i-map', title: 'Itinerarios', text: 'optimizados' },
  { icon: 'i-pin', title: 'Lugares', text: 'que realmente merecen la pena' },
  { icon: 'i-fork', title: 'Restaurantes', text: 'recomendados' },
  { icon: 'i-tram', title: 'Guía del metro', text: 'paso a paso' },
  { icon: 'i-bulb', title: 'Trucos', text: 'para ahorrar tiempo y evitar errores' }
];
---
<section class="section ebook-section" id="ebook">
  <div class="wrap ebook-grid">
    <div class="ebook-cover" aria-hidden="true">
      <img src="/images/ebook.webp" alt="" />
    </div>
    <div>
      <span class="eyebrow ebook-eyebrow">La guía de Wilson</span>
      <h2 class="section-title">Tu viaje a Nueva York empieza aquí</h2>
      <p class="section-sub">Todo lo que Wilson recomienda después de años recorriendo Nueva York: qué ver, dónde comer, cómo moverte y cómo organizar tu viaje para aprovecharlo al máximo.</p>
      <ul class="ebook-list">
        {benefits.map((b) => (
          <li><svg class="icon"><use href={`#${b.icon}`} /></svg><span><strong>{b.title}</strong> {b.text}</span></li>
        ))}
      </ul>
      <div class="ebook-countdown" id="ebookCountdown">
        <span class="ebook-countdown-label"><svg class="icon"><use href="#i-clock" /></svg>Oferta termina en</span>
        <span class="ebook-countdown-time" id="ebookCountdownTime">--h --m --s</span>
      </div>
      <div class="ebook-price-row">
        <div class="ebook-price">$13.99 <small>$19.99</small></div>
        <a class="btn btn-primary" href="https://buy.stripe.com/fZu9ANeiw7vd6Sc8Cqc3m03?fbclid=PAcGRvZgRleHRuA2FlbQIxMQBzcnRjBmFwcF9pZAwyNTYyODEwNDA1NTgAAaeuSI8Mb8sEaE0ZnRfDwvMzPABQ4V5OZXFsriY-aEGQqOWuLBcEdw9ETxv5GA_aem_1RqlM-95353KmnjUtuolnA" target="_blank" rel="noopener"><svg class="icon"><use href="#i-book" /></svg>Comprar ebook</a>
      </div>
    </div>
  </div>
</section>
