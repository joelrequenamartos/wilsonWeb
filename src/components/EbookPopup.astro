---
// Popup del ebook: sale a los 6 segundos, solo dentro de cada entrada del blog (no en el listado).
// Si se cierra (o se pulsa el botón), no vuelve a salir durante 3 días en ese navegador.
---
<div class="ebook-pop" id="ebookPop" role="dialog" aria-modal="true" aria-labelledby="ebookPopTitle" hidden>
  <div class="ebook-pop-card">
    <button class="ebook-pop-close" id="ebookPopClose" type="button" aria-label="Cerrar">×</button>
    <div class="ebook-pop-media">
      <img src="/images/ebook.webp" alt="Portada del ebook de Wilson sobre Nueva York" loading="lazy" />
    </div>
    <div class="ebook-pop-body">
      <span class="ebook-pop-eyebrow">Oferta limitada</span>
      <h2 id="ebookPopTitle">Tu viaje a Nueva York empieza aquí</h2>
      <p>La guía de Wilson con itinerarios optimizados, los lugares que de verdad merecen la pena, restaurantes recomendados y trucos para ahorrar tiempo y evitar errores.</p>
      <a class="btn btn-primary ebook-pop-cta" href="/ebook" id="ebookPopCta"><svg class="icon"><use href="#i-book" /></svg>Ver el ebook</a>
    </div>
  </div>
</div>

<script>
  const pop = document.getElementById('ebookPop');
  if (pop) {
    const KEY = 'ebook-popup-cerrado';
    const DIAS = 3;
    let visto = false;
    try { const t = Number(localStorage.getItem(KEY)); visto = t && Date.now() - t < DIAS * 86400000; } catch {}

    const cerrar = () => {
      pop.classList.remove('is-open');
      document.body.classList.remove('ebook-pop-lock');
      setTimeout(() => { pop.hidden = true; }, 300);
      try { localStorage.setItem(KEY, String(Date.now())); } catch {}
      document.removeEventListener('keydown', onKey);
      if (previo && previo.focus) previo.focus();
    };
    const onKey = (e) => { if (e.key === 'Escape') cerrar(); };
    let previo = null;

    const abrir = () => {
      previo = document.activeElement;
      pop.hidden = false;
      document.body.classList.add('ebook-pop-lock');
      requestAnimationFrame(() => pop.classList.add('is-open'));
      document.getElementById('ebookPopClose').focus();
      document.addEventListener('keydown', onKey);
    };

    document.getElementById('ebookPopClose').addEventListener('click', cerrar);
    document.getElementById('ebookPopCta').addEventListener('click', () => { try { localStorage.setItem(KEY, String(Date.now())); } catch {} });
    pop.addEventListener('click', (e) => { if (e.target === pop) cerrar(); }); // clic fuera de la tarjeta

    if (!visto) setTimeout(abrir, 6000);
  }
</script>
