---
// Guía gratuita en PDF (public/guia-gratuita-nueva-york.pdf, versión comprimida de ~4 MB).
const GUIA_URL = '/guia-gratuita-nueva-york.pdf';
// Popup de la guía gratuita: sale a los 6 segundos, solo dentro de cada entrada del blog (no en el listado).
// Se cierra solo con la × o con Esc (no al hacer clic fuera). Al cerrarlo, o al pulsar el botón, no vuelve a salir durante 3 días.
---
<div class="ebook-pop" id="ebookPop" role="dialog" aria-modal="true" aria-labelledby="ebookPopTitle" hidden>
  <div class="ebook-pop-card">
    <button class="ebook-pop-close" id="ebookPopClose" type="button" aria-label="Cerrar">×</button>
    <div class="ebook-pop-media">
      <img src="/images/ebook.webp" alt="Portada de la guía de Wilson sobre Nueva York" loading="lazy" />
    </div>
    <div class="ebook-pop-body">
      <span class="ebook-pop-eyebrow">Guía gratuita</span>
      <h2 id="ebookPopTitle">¿Tienes pensado viajar a Nueva York?</h2>
      <p>Descubre algunos de los mejores consejos, lugares y recomendaciones de Wilson para preparar tu viaje a Nueva York. Un adelanto de su guía completa.</p>
      <a class="btn btn-primary ebook-pop-cta" href={GUIA_URL} download="Guia-Nueva-York-Wilson.pdf" id="ebookPopCta"><svg class="icon"><use href="#i-book" /></svg>Descárgala aquí</a>
      <small class="ebook-pop-note">Descarga inmediata en PDF · Sin registro</small>
    </div>
  </div>
</div>

<script>
  const pop = document.getElementById('ebookPop');
  if (pop) {
    const KEY = 'ebook-popup-cerrado';
    const DIAS = 3;
    let visto = false;
    try { const t = Number(localStorage.getItem(KEY)); visto = t && Date.now() - t < DIAS * 86400000; } catch {}

    const cerrar = () => {
      pop.classList.remove('is-open');
      document.body.classList.remove('ebook-pop-lock');
      setTimeout(() => { pop.hidden = true; }, 300);
      try { localStorage.setItem(KEY, String(Date.now())); } catch {}
      document.removeEventListener('keydown', onKey);
      if (previo && previo.focus) previo.focus();
    };
    const onKey = (e) => { if (e.key === 'Escape') cerrar(); };
    let previo = null;

    const abrir = () => {
      previo = document.activeElement;
      pop.hidden = false;
      document.body.classList.add('ebook-pop-lock');
      requestAnimationFrame(() => pop.classList.add('is-open'));
      document.getElementById('ebookPopClose').focus();
      document.addEventListener('keydown', onKey);
    };

    document.getElementById('ebookPopClose').addEventListener('click', cerrar);
    document.getElementById('ebookPopCta').addEventListener('click', () => { try { localStorage.setItem(KEY, String(Date.now())); } catch {} });
    // No se cierra al hacer clic fuera de la tarjeta: solo con la × (o con Esc).

    if (!visto) setTimeout(abrir, 6000);
  }
</script>
