---
import type { RestaurantEntry } from '../lib/restaurants';
import { restaurantImage } from '../lib/restaurantImages';
import { adjustStyle, logoStyle } from '../lib/restaurants';

interface Props {
  restaurants: RestaurantEntry[];
}

const { restaurants } = Astro.props;

const featured = restaurants
  .filter((r) => r.data.featuredRank)
  .sort((a, b) => (a.data.featuredRank ?? 0) - (b.data.featuredRank ?? 0));
---
<div class="dest-banner reveal" id="destBanner" aria-roledescription="carrusel" aria-label="Top 3 restaurantes destacados" tabindex="0">
  <span class="dest-sponsor-badge"><svg class="icon" style="width:12px;height:12px"><use href="#i-star" /></svg>Espacio destacado</span>
  <div class="dest-track" id="destTrack">
    {featured.map((restaurant) => {
      const photo = restaurant.data.banner || restaurantImage(restaurant.data.id, 'banner');
      return (
      <div class:list={['dest-slide', { 'has-photo': photo }]}>
        {photo && <div class="dest-bg" style={`background-image:url('${photo}');${adjustStyle(restaurant.data.adjust?.banner) ?? ''}`}></div>}
        <div class:list={['dest-art', restaurant.data.art]} aria-hidden="true">
          {(restaurant.data.logo || restaurantImage(restaurant.data.id, 'logo'))
            ? <img src={restaurant.data.logo || restaurantImage(restaurant.data.id, 'logo')} alt="" loading="lazy" style={logoStyle(restaurant.data.adjust?.logo)} />
            : <svg class="icon" style="width:30px;height:30px"><use href="#i-fork" /></svg>}
        </div>
        <div class="dest-body">
          <span class="dest-rank">Destacado · Nº{restaurant.data.featuredRank}</span>
          <h3>{restaurant.data.name}</h3>
          <div class="rest-tags"><span>{restaurant.data.cuisineLabel}</span><span>📍 {restaurant.data.neighborhood}</span></div>
          <p class="rest-note">{restaurant.data.note}</p>
        </div>
        <a class="btn btn-primary btn-sm dest-cta" href="/restaurantes">Ver restaurantes</a>
      </div>
      );
    })}
  </div>

  <button class="dest-arrow dest-prev" id="destPrev" aria-label="Restaurante anterior">
    <svg class="icon" style="width:18px;height:18px"><use href="#i-arrow" /></svg>
  </button>
  <button class="dest-arrow dest-next" id="destNext" aria-label="Restaurante siguiente">
    <svg class="icon" style="width:18px;height:18px"><use href="#i-arrow" /></svg>
  </button>

  <div class="dest-bottom">
    <div class="dest-dots" id="destDots">
      {featured.map((_, i) => (
        <button class="dest-dot" aria-current={i === 0 ? 'true' : 'false'} aria-label={`Ir al destacado ${i + 1}`}></button>
      ))}
    </div>
    <button class="dest-pause" id="destPause" aria-label="Pausar rotación automática" aria-pressed="false">
      <svg class="icon" id="destPauseIcon" style="width:13px;height:13px"><use href="#i-pause" /></svg>
    </button>
  </div>
</div>
