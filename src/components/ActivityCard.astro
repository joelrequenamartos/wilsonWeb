---
// Tarjeta de actividad: al pulsar en cualquier parte se abre la ficha en una ventana (pop-up) con la descripción completa;
// desde ahí, «Ver detalles» lleva a la web donde se reserva (nosotros solo informamos y redirigimos).
import type { Activity } from '../lib/activities';
import { formatPrice } from '../lib/activities';

interface Props {
  activity: Activity;
}

const { activity: a } = Astro.props;
const hasPrice = !a.free && a.price !== null;
// Fotos de la ventana: portada + carrusel (sin repetir)
const photos = [...new Set([a.image, ...a.gallery].filter(Boolean))];
---
<article class="act-card" data-tag={a.tag} data-link={a.link} data-photos={JSON.stringify(photos)}>
  <div class="act-img">
    {a.image ? <img src={a.image} alt="" loading="lazy" /> : <svg class="icon" aria-hidden="true"><use href="#i-ticket" /></svg>}
  </div>
  <div class="act-body">
    <h2 class="act-title"><button type="button" class="act-open" aria-haspopup="dialog">{a.title}</button></h2>
    {a.highlight && <span class="act-highlight">{a.highlight}</span>}
    {a.description && <p class="act-desc">{a.description}</p>}
    {a.tag && <span class="act-tag"><svg class="icon" aria-hidden="true"><use href="#i-ticket" /></svg>{a.tag}</span>}
  </div>
  <div class="act-side">
    <div class="act-price">
      {a.free ? (
        <span class="act-free">Gratis</span>
      ) : hasPrice ? (
        <>
          {a.priceFrom && <small class="act-from">desde</small>}
          {a.oldPrice !== null && a.oldPrice > (a.price ?? 0) && <s class="act-old">{formatPrice(a.oldPrice, a.currency)}</s>}
          <span class="act-amount">{formatPrice(a.price as number, a.currency)}</span>
        </>
      ) : null}
    </div>
    <span class="act-btn" aria-hidden="true">Ver detalles</span>
  </div>
</article>
