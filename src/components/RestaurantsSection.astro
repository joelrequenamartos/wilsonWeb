---
import type { RestaurantEntry } from '../lib/restaurants';
import { CUISINES } from '../lib/restaurants';
import RestaurantCard from './RestaurantCard.astro';
import AdBanner from './AdBanner.astro';

interface Props {
  restaurants: RestaurantEntry[];
}

const { restaurants } = Astro.props;

const filterLabels = CUISINES;

// Los 3 destacados van solo en el banner «Espacio destacado»; las tarjetas pequeñas son el resto.
const gridRestaurants = restaurants.filter((r) => r.data.featuredRank == null);

// Orden fijo de las pestañas de filtro (independiente del orden de la rejilla).
const cuisineOrder = Object.keys(CUISINES);
const tabs = cuisineOrder.map((cuisine) => ({
  cuisine,
  label: filterLabels[cuisine] ?? cuisine,
  count: gridRestaurants.filter((r) => r.data.cuisine === cuisine).length
}));
---
<section class="section section-alt" id="restaurantes">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Comer como local</span>
      <h2 class="section-title">Los Mejores Restaurantes de Nueva York</h2>
      <p class="section-sub">Seleccionados por cercanía a nuestros tours y por algo más importante: que valgan la parada. Filtra por tipo de cocina.</p>
    </div>

    <AdBanner restaurants={restaurants} />

    <div class="rest-search">
      <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
      <input type="search" id="restSearch" placeholder="Buscar restaurante por nombre…" aria-label="Buscar restaurante por nombre" autocomplete="off" />
    </div>

    <div class="map-tabs" role="group" aria-label="Filtrar restaurantes por cocina" id="restTabs">
      <button class="map-tab" data-filter="all" aria-pressed="true">Todos <span class="tab-count">{gridRestaurants.length}</span></button>
      {tabs.map((tab) => (
        <button class="map-tab" data-filter={tab.cuisine} aria-pressed="false">{tab.label} <span class="tab-count">{tab.count}</span></button>
      ))}
    </div>

    <p class="rest-empty" id="restEmpty" hidden>No hay restaurantes que coincidan — prueba otro nombre o filtro.</p>

    <div class="grid grid-3" id="restGrid">
      {gridRestaurants.map((restaurant) => <RestaurantCard restaurant={restaurant.data} />)}
    </div>

    <div class="rest-more-wrap">
      <button class="btn btn-outline" id="restMoreBtn" hidden>Ver más restaurantes</button>
    </div>
  </div>
</section>

<div class="promo-modal" id="promoModal" aria-hidden="true">
  <div class="promo-card" role="dialog" aria-modal="true" aria-labelledby="promoTitle">
    <button class="promo-close" id="promoClose" type="button" aria-label="Cerrar">
      <svg class="icon"><use href="#i-close" /></svg>
    </button>
    <span class="promo-tag">Promoción</span>
    <h3 id="promoTitle"></h3>
    <div class="promo-text" id="promoText"></div>
    <a class="btn btn-primary" id="promoGo" href="#" target="_blank" rel="noopener noreferrer">Ir a la web</a>
  </div>
</div>
