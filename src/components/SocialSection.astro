---
import { socials } from '../data/socials';

// Hasta que haya un feed automático de Instagram, los reels se cargan a mano
// aquí (portada + link al reel, vídeo opcional). Los huecos vacíos se quedan como placeholder.
type Reel = { poster: string; video?: string; href?: string };
const reels: (Reel | null)[] = [
  { poster: '/images/reels/DH1PUnZucpZ.jpg', href: 'https://www.instagram.com/reel/DH1PUnZucpZ/' },
  { poster: '/images/reels/DHoUII8uLD9.jpg', href: 'https://www.instagram.com/reel/DHoUII8uLD9/' },
  { poster: '/images/reels/DcG3W51u1-s.jpg', href: 'https://www.instagram.com/reel/DcG3W51u1-s/' },
  { poster: '/images/reels/DJhRj4qO7bP.jpg', href: 'https://www.instagram.com/reel/DJhRj4qO7bP/' },
  { poster: '/images/reels/DHjKAk-unKB.jpg', href: 'https://www.instagram.com/reel/DHjKAk-unKB/' }
];
---
<section class="section" id="social">
  <div class="wrap">
    <div class="section-head reveal" style="margin-inline:auto; text-align:center;">
      <h2 class="section-title">¿Quieres descubrir más cosas sobre Nueva York?</h2>
      <p class="section-sub" style="margin-inline:auto;">Los últimos reels y todas nuestras redes en un mismo sitio</p>
    </div>

    <div class="social-icons-row reveal">
      {socials.map((s) => (
        <a class="social-icon-btn" href={s.href} aria-label={s.label} target="_blank" rel="noopener">
          <svg class="icon" style="width:22px;height:22px"><use href={`#${s.icon}`} /></svg>
        </a>
      ))}
    </div>

    <div class="reels-grid reveal">
      {reels.map((reel) => (
        reel ? (
          <a class="reel-video-card" href={reel.href} target={reel.href ? '_blank' : undefined} rel={reel.href ? 'noopener' : undefined} aria-label="Ver reel en Instagram">
            {reel.video ? (
              <video
                src={reel.video}
                poster={reel.poster}
                muted
                loop
                playsinline
                preload="metadata"
              />
            ) : (
              <img src={reel.poster} alt="" loading="lazy" />
            )}
            <span class="reel-play-hint"><svg class="icon" style="width:20px;height:20px"><use href="#i-play" /></svg></span>
          </a>
        ) : (
          <div class="reel-placeholder">
            <svg class="icon" style="width:26px;height:26px"><use href="#i-play" /></svg>
            <span>Reel próximamente</span>
          </div>
        )
      ))}
    </div>
  </div>
</section>
