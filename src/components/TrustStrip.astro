---
const items = [
  { icon: 'i-card', label: 'Aceptamos tarjeta' },
  { icon: 'i-family', label: 'Niños entran gratis' },
  { icon: 'i-badge', label: 'Guía certificado' },
  { icon: 'i-clock', label: 'Atención 24/7' },
  { icon: 'i-chat', label: 'Consulta sin compromiso' }
];
---
<section class="trust-strip">
  <div class="wrap trust-grid">
    {items.map((item) => (
      <div class="trust-item"><svg class="icon"><use href={`#${item.icon}`} /></svg>{item.label}</div>
    ))}
  </div>
</section>
