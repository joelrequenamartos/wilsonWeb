---
import type { CollectionEntry } from 'astro:content';

interface Props {
  reviews: CollectionEntry<'reviews'>[];
}

const { reviews } = Astro.props;

const photoCount = 12;
// Orden pedido: 06, 03, 02, 09 primero; el resto da igual el orden.
const priorityOrder = [6, 3, 2, 9];
const rest = Array.from({ length: photoCount }, (_, i) => i + 1).filter((n) => !priorityOrder.includes(n));
const photoOrder = [...priorityOrder, ...rest];
const photos = photoOrder.map((n) => `/images/reviews/review-${String(n).padStart(2, '0')}.jpg`);

const slides = photos.map((src, i) => ({ src, review: reviews[i % reviews.length]?.data }));

// Clones a cada lado para que el carrusel sea cíclico de verdad: al pasar
// del último al primero (o viceversa) se salta al instante sin cruzar
// visualmente por todas las fotos intermedias.
const CLONES = 2;
const loopSlides = [...slides.slice(-CLONES), ...slides, ...slides.slice(0, CLONES)];
---
<div
  class="review-carousel reveal"
  id="reviewCarousel"
  aria-roledescription="carrusel"
  aria-label="Reseñas de clientes con fotos de nuestros tours"
  data-real-length={slides.length}
  data-clones={CLONES}
>
  <button class="review-nav-btn review-prev" id="reviewPrev" aria-label="Reseña anterior">
    <svg class="icon"><use href="#i-arrow" /></svg>
  </button>

  <div class="review-viewport">
    <div class="review-track" id="reviewTrack">
      {loopSlides.map((slide, i) => (
        <div class="review-slide" data-index={i}>
          <div class="review-slide-photo">
            <img src={slide.src} alt={`Clientes de Silver Tours NY en uno de nuestros tours`} />
          </div>
          {slide.review && (
            <div class="review-slide-quote">
              <div class="review-top">
                {slide.review.avatar
                  ? <img class="avatar avatar-photo" src={slide.review.avatar} alt={slide.review.name} loading="lazy" />
                  : <div class="avatar" style={`background:${slide.review.avatarColor}`}>{slide.review.initial}</div>
                }
                <div><div class="review-name">{slide.review.name}</div><div class="review-source">{slide.review.source} · {slide.review.context}</div></div>
              </div>
              <span class="stars" aria-label={`${slide.review.rating} de 5 estrellas`}>{'★'.repeat(slide.review.rating)}{'☆'.repeat(5 - slide.review.rating)}</span>
              <div class="review-quote-wrap">
                <p class="review-quote">"{slide.review.quote}"</p>
                {/* Solo se muestra (vía JS) cuando el texto no cabe en las líneas visibles */}
                <button type="button" class="review-readmore" hidden>Leer más</button>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <button class="review-nav-btn review-next" id="reviewNext" aria-label="Reseña siguiente">
    <svg class="icon"><use href="#i-arrow" /></svg>
  </button>
</div>

<div class="review-lightbox" id="reviewLightbox" aria-hidden="true">
  <div class="review-lightbox-card" role="dialog" aria-modal="true" aria-label="Reseña completa">
    <button class="review-lightbox-close" id="reviewLightboxClose" aria-label="Cerrar reseña">
      <svg class="icon"><use href="#i-close" /></svg>
    </button>
    <div class="review-top" id="reviewLightboxTop"></div>
    <span class="stars" id="reviewLightboxStars"></span>
    <p class="review-lightbox-quote" id="reviewLightboxQuote"></p>
  </div>
</div>
