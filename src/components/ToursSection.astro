---
import type { CollectionEntry } from 'astro:content';
import TourCard from './TourCard.astro';

interface Props {
  tours: CollectionEntry<'tours'>[];
}

const { tours } = Astro.props;
---
<section class="section" id="tours">
  <div class="wrap">
    <div class="section-head-split reveal tours-head">
      <h2 class="section-title">Tours Disponibles</h2>
      <div class="tours-nav">
        <button class="tours-nav-btn tours-prev" id="toursPrev" aria-label="Tour anterior">
          <svg class="icon"><use href="#i-arrow" /></svg>
        </button>
        <button class="tours-nav-btn tours-next" id="toursNext" aria-label="Tour siguiente">
          <svg class="icon"><use href="#i-arrow" /></svg>
        </button>
      </div>
    </div>

    <div class="tours-scroll" id="toursScroll">
      <div class="tours-track" id="toursTrack">
        {tours.map((tour) => <TourCard tour={tour.data} />)}
      </div>
    </div>
  </div>
</section>
