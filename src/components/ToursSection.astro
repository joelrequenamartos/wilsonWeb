---
import type { CollectionEntry } from 'astro:content';
import TourCard from './TourCard.astro';

interface Props {
  tours: CollectionEntry<'tours'>[];
}

const { tours } = Astro.props;
---
<section class="section section-alt" id="tours">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Tu pase de acceso a la ciudad</span>
      <h2 class="section-title">Tours diseñados como rutas, no como itinerarios</h2>
      <p class="section-sub">Cada tour es un recorrido con paradas reales: del streetball de Harlem a un juego en vivo, de una misa góspel a la mesa de un restaurante local. Elige el tuyo.</p>
    </div>

    <div class="grid grid-3">
      {tours.map((tour) => <TourCard tour={tour.data} />)}
    </div>
  </div>
</section>
