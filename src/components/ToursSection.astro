---
import type { CollectionEntry } from 'astro:content';
import TourCard from './TourCard.astro';

interface Props {
  tours: CollectionEntry<'tours'>[];
}

const { tours } = Astro.props;
---
<section class="section section-alt" id="tours">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 class="section-title">Tours Disponibles</h2>
    </div>

    <div class="grid grid-2 tours-grid">
      {tours.map((tour) => <TourCard tour={tour.data} />)}
    </div>
  </div>
</section>
